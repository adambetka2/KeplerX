 "definitions": {
  "VALIDATED_BY_MULTIPLICITY": "20 V3 repeats, NFPP < 0.1% and boosted FPP < 1.5% (b = 5.5) with every multiplicity condition (Lissauer et al. 2014; Rowe et al. 2014 section 5.9); host star undetermined.",
  "POSSIBLE_PLANET": "20 V3 repeats, NFPP < 0.1% and FPP 1.5-50% (Gomez Barrientos et al. 2025); without high-resolution imaging the first eight single-host M/K campaigns stopped at FPP 2-4% (planet on an unresolved bound companion), an observed pattern rather than a limit.",
  "TRICERATOPS_FP_CATEGORY": "FPP > 70% or NFPP > 10%; a statistical category, not a reproduced mechanism. dominant_alternative names the largest scenario.",
  "NUMERICAL_PASS_PHYSICAL_REVIEW_REQUIRED": "20 V3 repeats with mean FPP < 1.5%, mean NFPP < 0.1% and radius below 8 Earth radii, and the automated closeout items pass (S/N >= 15, RUWE <= 1.4, no Gaia source within 1.5 arcsec, no phase-0.5 secondary at S/N >= 3); the ephemeris-match and literature review and Adam's admission remain.",
  "NUMERICAL_PASS_CLOSEOUT_FAILED": "20 V3 repeats with mean FPP < 1.5%, mean NFPP < 0.1% and radius below 8 Earth radii, but a declared closeout item fails (closeout_failed): not validated.",
  "NUMERICAL_PASS_CLOSEOUT_PENDING": "A numerical V3 pass whose closeout or occultation record is not yet written.",
  "STOPPED_EARLY_REMAINS_PC": "Both first V3 repeats have FPP >= 10% or NFPP >= 1% (futility rule); remains a planet candidate.",
  "FALSE_POSITIVE_INSTRUMENTAL_DATE": "One event on a date with a population-wide event excess (BKJD 200, 246 or 373; z = 79, 72 and 13 in 0.5-day bins of 17,940 M/K proposals) carries at least half of the S/N squared and the other events fall below S/N 7.1 in local KBonus SAP: the detection is an artifact of that date.",
  "PERIOD_UNSUPPORTED_SINGLE_EVENT": "One event carries at least half of the S/N squared and the others fall below S/N 7.1: the period is unsupported; the single event may still be real.",
  "NOT_REPRODUCED_IN_LOCAL_SAP (NOT_RUN_EVENT_REVIEW)": "Local KBonus SAP event S/N below 5 with errors that understate correlated noise.",
  "NOT_INDEPENDENT_ALIAS_OR_DUPLICATE": "An S/N-consistent alias of, or sharing events with, a stronger signal on the same source (alias_or_duplicate_of).",
  "SAME_SIGNAL_AS_SURVEY_BOI": "The same signal as a survey BOI; its disposition is in the survey records.",
  "HELD_*": "A V3 step cannot be completed: hold_reason and the case record give the step and evidence.",
  "HELD_NATIVE_NO_PHYSICAL_ORBIT": "Every native posterior sample has periastron inside the star, a(1 - e) < R* + Rp (EXOFASTv2 boundary, tools/review_native.py): a planet on this host is excluded; the signal may belong to another star. No mechanism reproduced.",
  "NOT_RUN_*": "Not prepared for V3 for the first failed selection check (not_run_checks).",
  "NOT_RUN_LOW_SNR_PARKED": "Acquired and staged, then parked before any native fit (Adam, 26 October 2026): search S/N below 10 on a single host cannot validate under the agreed rules. Resumable from mk/queue-tail-20261026.json."
 },
