  "schema_version": 3,
  "data_kind": "SYNTHETIC_THEORETICAL_REFERENCE",
  "title": "Primordial-black-hole microlensing hypothesis",
  "model_status": "Physical point-lens model; primordial origin is an unverified hypothesis, not a distinctive waveform.",
  "source_papers": [
    {
      "title": "Sugiyama, Kurita & Takada (2020), On the wave optics effect on primordial black hole constraints from optical microlensing search",
      "url": "https://arxiv.org/abs/1905.06066",
      "used_for": "Equations 3, 4, 6, 12–13: point lens, time trajectory, wave parameter and uniform finite-source average."
    },
    {
      "title": "Tamta, Raj & Sharma (2024), Breaking into the window of primordial black hole dark matter with x-ray microlensing",
      "url": "https://arxiv.org/abs/2405.20365",
      "used_for": "Recent discussion of finite-source and wave effects. Its X-ray instrument forecasts are not used as optical predictions."
    }
  ],
  "equations": {
    "Einstein_radius": "RE=sqrt(4GM DL(1-DL/DS)/c^2)",
    "trajectory": "u(t)=sqrt(u0^2+(t/tE)^2); tE=RE/v; u0=b_source*RS*DL/(DS*RE)",
    "point_source": "A=(u^2+2)/(u sqrt(u^2+4))",
    "finite_source": "Afs=(pi rho^2)^-1 integral_source_disk A_point d^2y; rho=RS*DL/(DS*RE)",
    "blending": "F=1+fs*(Afs-1)",
    "wave_validity": "w=8*pi*G*M/(c^2*lambda); refuse w<100 (no wave-optics implementation)"
  },
